---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="nourd-identity" href={`${base}/`} aria-label="Nourd Knowledge Format — home">
  <img src={`${base}/brand/nourd-logo.svg`} alt="" width="76" height="36" />
  <span class="identity-divider" aria-hidden="true"></span>
  <span class="identity-name">Knowledge Format<span class="identity-short">NKF</span></span>
</a>
