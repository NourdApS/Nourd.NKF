{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nkf:0.1:schema:bundle",
  "title": "NKF 0.1 bundle",
  "x-nkf-source": {
    "nkf_version": "0.1",
    "markdown_path": "knowledge/specifications/nkf-0.1.md",
    "markdown_digest": {
      "algorithm": "sha-256",
      "value": "df0235ee01ba951fe5beea50990213e4d1063b2e7014f460657de6904d5fabc0"
    },
    "executable_path": "contracts/nkf/0.1/nkf.yaml",
    "executable_digest": {
      "algorithm": "sha-256",
      "value": "3cd00712ecf5fc4d4ae6faa275fd04373d28802eb1de80f6c47f6f039026f0aa"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nkf_version",
    "contract",
    "id",
    "root",
    "knowledge_root",
    "non_records"
  ],
  "properties": {
    "nkf_version": {
      "const": "0.1"
    },
    "contract": {
      "const": "nkf.bundle"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "root": {
      "$ref": "#/$defs/root"
    },
    "knowledge_root": {
      "type": "string",
      "minLength": 1
    },
    "non_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonRecord"
      }
    },
    "canonical_terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+(?: [^\\s\\u0000-\\u001f\\u007f]+)*$"
      }
    },
    "governed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/governedArtifact"
      }
    },
    "extension_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/extensionContract"
      }
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/extensionUse"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "profile"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/identifier"
        },
        "profile": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "governedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "digest",
        "record",
        "source_section"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "executable-contract",
            "schema",
            "checker-source",
            "test",
            "fixture",
            "build-tool",
            "project-configuration"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "record": {
          "$ref": "#/$defs/identifier"
        },
        "source_section": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "extensionIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?){2,}$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "digest"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "extensionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "specification",
        "executable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/extensionIdentifier"
        },
        "specification": {
          "$ref": "#/$defs/artifactReference"
        },
        "executable": {
          "$ref": "#/$defs/artifactReference"
        }
      }
    },
    "extensionUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "requirement",
        "payload"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/extensionIdentifier"
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "payload": {}
      }
    },
    "nonRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "navigation",
            "task",
            "evidence",
            "generated",
            "redirect",
            "other"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "other"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  }
}
