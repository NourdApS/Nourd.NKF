{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nkf:0.2:schema:release-manifest",
  "title": "NKF 0.2 release manifest",
  "x-nkf-source": {
    "nkf_version": "0.2",
    "markdown_path": "knowledge/specifications/nkf-0.2.md",
    "markdown_digest": {
      "algorithm": "sha-256",
      "value": "df2e457e5e3824004268efebdead93be56df36c3754cf563b2701cee0474c26f"
    },
    "executable_path": "contracts/nkf/0.2/nkf.yaml",
    "executable_digest": {
      "algorithm": "sha-256",
      "value": "087934ec88de7f6c25b64e9706599403876d28cbc1f0accd50bc9bfbdd419b27"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "nkf_version",
    "source",
    "checker",
    "authority",
    "schemas"
  ],
  "properties": {
    "contract": {
      "const": "nkf.release-manifest"
    },
    "nkf_version": {
      "const": "0.2"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "checker": {
      "$ref": "#/$defs/checker"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "schemas": {
      "$ref": "#/$defs/schemas"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "checkerConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "path",
        "digest",
        "checker_source_commit"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "pattern": "^ADR-[0-9]{4}$"
        },
        "path": {
          "type": "string",
          "pattern": "^knowledge/decisions/[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "checker_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "release_commit",
        "checker_confirmation"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/kaveh6202/Nourd.NKF.git"
        },
        "release_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "checker_confirmation": {
          "$ref": "#/$defs/checkerConfirmation"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "minimum_major"
      ],
      "properties": {
        "name": {
          "const": "node"
        },
        "minimum_major": {
          "const": 22
        }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "path",
        "digest",
        "runtime"
      ],
      "properties": {
        "identity": {
          "const": "nourd-nkf-checker"
        },
        "path": {
          "const": "dist/nourd-nkf-checker.mjs"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "markdownArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "knowledge/specifications/nkf-0.2.md"
            }
          }
        }
      ]
    },
    "executableArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "contracts/nkf/0.2/nkf.yaml"
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precedence",
        "markdown",
        "executable"
      ],
      "properties": {
        "precedence": {
          "const": "normative-markdown"
        },
        "markdown": {
          "$ref": "#/$defs/markdownArtifact"
        },
        "executable": {
          "$ref": "#/$defs/executableArtifact"
        }
      }
    },
    "schemaArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "path",
        "digest"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "bundleSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.2:schema:bundle"
            },
            "path": {
              "const": "contracts/nkf/0.2/schemas/bundle.schema.json"
            }
          }
        }
      ]
    },
    "recordSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.2:schema:record"
            },
            "path": {
              "const": "contracts/nkf/0.2/schemas/record.schema.json"
            }
          }
        }
      ]
    },
    "releaseManifestSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.2:schema:release-manifest"
            },
            "path": {
              "const": "contracts/nkf/0.2/schemas/release-manifest.schema.json"
            }
          }
        }
      ]
    },
    "validationResultSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.2:schema:validation-result"
            },
            "path": {
              "const": "contracts/nkf/0.2/schemas/validation-result.schema.json"
            }
          }
        }
      ]
    },
    "schemas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/bundleSchema"
        },
        {
          "$ref": "#/$defs/recordSchema"
        },
        {
          "$ref": "#/$defs/releaseManifestSchema"
        },
        {
          "$ref": "#/$defs/validationResultSchema"
        }
      ],
      "items": false
    }
  }
}
