{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nkf:0.5:schema:release-manifest",
  "title": "NKF 0.5 release manifest",
  "x-nkf-source": {
    "nkf_version": "0.5",
    "markdown_path": "knowledge/specifications/nkf-0.5-revision-2.md",
    "markdown_digest": {
      "algorithm": "sha-256",
      "value": "0f3b7c085eba4fa92655e20916fccb7013169b5560dd50c241fb4726df31287c"
    },
    "executable_path": "contracts/nkf/0.5/revision-2/nkf.yaml",
    "executable_digest": {
      "algorithm": "sha-256",
      "value": "2743102a4bddf9a26253fba3982f00bf9c688c819891815221e3ea4ee67c5290"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "nkf_version",
    "source",
    "checker",
    "authority",
    "freshness_policy",
    "schemas",
    "files"
  ],
  "properties": {
    "contract": {
      "const": "nkf.release-manifest"
    },
    "nkf_version": {
      "const": "0.5"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "checker": {
      "$ref": "#/$defs/checker"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "schemas": {
      "$ref": "#/$defs/schemas"
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "freshness_policy": {
      "$ref": "#/$defs/freshnessPolicy"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "release_commit"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/kaveh6202/Nourd.NKF.git"
        },
        "release_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "minimum_major"
      ],
      "properties": {
        "name": {
          "const": "node"
        },
        "minimum_major": {
          "const": 22
        }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "path",
        "digest",
        "runtime"
      ],
      "properties": {
        "identity": {
          "const": "nourd-nkf-checker"
        },
        "path": {
          "const": "dist/nourd-nkf-checker.mjs"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "markdownArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "knowledge/specifications/nkf-0.5-revision-2.md"
            }
          }
        }
      ]
    },
    "executableArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "contracts/nkf/0.5/revision-2/nkf.yaml"
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precedence",
        "markdown",
        "executable"
      ],
      "properties": {
        "precedence": {
          "const": "normative-markdown"
        },
        "markdown": {
          "$ref": "#/$defs/markdownArtifact"
        },
        "executable": {
          "$ref": "#/$defs/executableArtifact"
        }
      }
    },
    "schemaArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "path",
        "digest"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "bundleSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.5:schema:bundle"
            },
            "path": {
              "const": "contracts/nkf/0.5/schemas/bundle.schema.json"
            }
          }
        }
      ]
    },
    "recordSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.5:schema:record"
            },
            "path": {
              "const": "contracts/nkf/0.5/schemas/record.schema.json"
            }
          }
        }
      ]
    },
    "releaseManifestSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.5:schema:release-manifest"
            },
            "path": {
              "const": "contracts/nkf/0.5/schemas/release-manifest.schema.json"
            }
          }
        }
      ]
    },
    "validationResultSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.5:schema:validation-result"
            },
            "path": {
              "const": "contracts/nkf/0.5/schemas/validation-result.schema.json"
            }
          }
        }
      ]
    },
    "schemas": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "$ref": "#/$defs/bundleSchema"
        },
        {
          "$ref": "#/$defs/recordSchema"
        },
        {
          "$ref": "#/$defs/graphBaselineSchema"
        },
        {
          "$ref": "#/$defs/freshnessReceiptSchema"
        },
        {
          "$ref": "#/$defs/freshnessPolicySchema"
        },
        {
          "$ref": "#/$defs/releaseManifestSchema"
        },
        {
          "$ref": "#/$defs/validationResultSchema"
        }
      ],
      "items": false
    },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[!-~]+$"
        },
        "mode": {
          "enum": [
            "0644",
            "0755"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "dist/nourd-nkf-checker.mjs"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "0755"
              }
            }
          },
          "else": {
            "properties": {
              "mode": {
                "const": "0644"
              }
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileArtifact"
      }
    },
    "freshnessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "path",
        "digest"
      ],
      "properties": {
        "identity": {
          "const": "nkf.freshness-policy.0.5"
        },
        "path": {
          "const": "contracts/nkf/0.5/freshness-policy.yaml"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "graphBaselineSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.5:schema:graph-baseline"
            },
            "path": {
              "const": "contracts/nkf/0.5/schemas/graph-baseline.schema.json"
            }
          }
        }
      ]
    },
    "freshnessReceiptSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.5:schema:freshness-receipt"
            },
            "path": {
              "const": "contracts/nkf/0.5/schemas/freshness-receipt.schema.json"
            }
          }
        }
      ]
    },
    "freshnessPolicySchema": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaArtifact"
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "const": "urn:nkf:0.5:schema:freshness-policy"
            },
            "path": {
              "const": "contracts/nkf/0.5/schemas/freshness-policy.schema.json"
            }
          }
        }
      ]
    }
  }
}
