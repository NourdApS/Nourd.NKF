{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nkf:0.1:schema:bundle",
  "title": "NKF 0.1 bundle",
  "x-nkf-source": {
    "nkf_version": "0.1",
    "markdown_path": "knowledge/specifications/nkf-0.1.md",
    "markdown_digest": {
      "algorithm": "sha-256",
      "value": "b83ab1ca6c93a1fed5a344a47a3d21d7691d93e141926f05e3d1c00ba8fe4e8c"
    },
    "executable_path": "contracts/nkf/0.1/nkf.yaml",
    "executable_digest": {
      "algorithm": "sha-256",
      "value": "e9cc92676d8f61855e1dea47ccc7eaa926c43003596158e15c7550ea14e6da41"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nkf_version",
    "contract",
    "id",
    "product_record",
    "knowledge_root",
    "non_records"
  ],
  "properties": {
    "nkf_version": {
      "const": "0.1"
    },
    "contract": {
      "const": "nkf.bundle"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "product_record": {
      "$ref": "#/$defs/identifier"
    },
    "knowledge_root": {
      "type": "string",
      "minLength": 1
    },
    "non_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonRecord"
      }
    },
    "canonical_terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+(?: [^\\s\\u0000-\\u001f\\u007f]+)*$"
      }
    },
    "extension_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/extensionContract"
      }
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/extensionUse"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "extensionIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?){2,}$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "digest"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "extensionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "specification",
        "executable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/extensionIdentifier"
        },
        "specification": {
          "$ref": "#/$defs/artifactReference"
        },
        "executable": {
          "$ref": "#/$defs/artifactReference"
        }
      }
    },
    "extensionUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "requirement",
        "payload"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/extensionIdentifier"
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "payload": {}
      }
    },
    "nonRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "navigation",
            "generated",
            "redirect",
            "other"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "other"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  }
}
