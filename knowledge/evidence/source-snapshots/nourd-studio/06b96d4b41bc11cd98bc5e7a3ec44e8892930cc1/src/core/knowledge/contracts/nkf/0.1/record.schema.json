{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nkf.record/v1",
  "title": "NKF 0.1 governed record declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "type",
    "body_contract",
    "title",
    "source",
    "governance",
    "scope",
    "sections",
    "relationships"
  ],
  "properties": {
    "contract": {
      "const": "nkf.record/v1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "type": {
      "$ref": "#/$defs/typeIdentifier"
    },
    "body_contract": {
      "$ref": "#/$defs/contractIdentifier"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/distributionPath"
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "status",
        "authority"
      ],
      "properties": {
        "lifecycle": {
          "enum": [
            "living",
            "immutable"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "accepted",
            "superseded",
            "retired"
          ]
        },
        "authority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "accepted_at": {
          "type": "string",
          "format": "date"
        },
        "acceptance_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "proposal_revision"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/identifier"
            },
            "proposal_revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{7,64}$"
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product"
      ],
      "properties": {
        "product": {
          "$ref": "#/$defs/identifier"
        },
        "subjects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading_path",
          "occurrence",
          "authority",
          "role"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "heading_path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1
          },
          "authority": {
            "$ref": "#/$defs/identifier"
          },
          "role": {
            "$ref": "#/$defs/identifier"
          },
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target",
          "source_section"
        ],
        "properties": {
          "type": {
            "$ref": "#/$defs/identifier"
          },
          "target": {
            "$ref": "#/$defs/identifier"
          },
          "source_section": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actorRole"
          }
        },
        "verifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actorRole"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenanceSource"
          }
        },
        "primary_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "source_section"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "source_section": {
              "$ref": "#/$defs/identifier"
            },
            "observed_at": {
              "$ref": "#/$defs/temporal"
            }
          }
        }
      }
    },
    "external_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authority",
          "relationship",
          "source_section"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "$ref": "#/$defs/identifier"
          },
          "source_section": {
            "$ref": "#/$defs/identifier"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "resolution_rule": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "properties": {
              "locator": {}
            },
            "required": [
              "locator"
            ]
          },
          {
            "properties": {
              "resolution_rule": {}
            },
            "required": [
              "resolution_rule"
            ]
          }
        ]
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "defining_section"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "kind": {
            "$ref": "#/$defs/identifier"
          },
          "defining_section": {
            "$ref": "#/$defs/identifier"
          },
          "address": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entity_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "source",
          "target",
          "source_section"
        ],
        "properties": {
          "type": {
            "$ref": "#/$defs/identifier"
          },
          "source": {
            "$ref": "#/$defs/entityReference"
          },
          "target": {
            "$ref": "#/$defs/entityReference"
          },
          "source_section": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "realization",
          "kind",
          "source_section"
        ],
        "properties": {
          "entity": {
            "$ref": "#/$defs/entityReference"
          },
          "realization": {
            "$ref": "#/$defs/identifier"
          },
          "kind": {
            "$ref": "#/$defs/identifier"
          },
          "source_section": {
            "$ref": "#/$defs/identifier"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "resolution_rule": {
            "type": "string",
            "minLength": 1
          },
          "external_authority": {
            "$ref": "#/$defs/identifier"
          }
        },
        "anyOf": [
          {
            "properties": {
              "locator": {}
            },
            "required": [
              "locator"
            ]
          },
          {
            "properties": {
              "resolution_rule": {}
            },
            "required": [
              "resolution_rule"
            ]
          }
        ]
      }
    },
    "required_extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contractIdentifier"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/contractIdentifier"
      },
      "additionalProperties": true
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "short_label": {
          "type": "string",
          "minLength": 1
        },
        "entry_section": {
          "$ref": "#/$defs/identifier"
        },
        "featured_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "initial_depth": {
          "enum": [
            "overview",
            "standard",
            "full"
          ]
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "typeIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "contractIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*/[a-z0-9.-]+$"
    },
    "distributionPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\$\\{)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "actorRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/identifier"
        },
        "at": {
          "$ref": "#/$defs/temporal"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenanceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "$ref": "#/$defs/temporal"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "last_modified_at": {
          "$ref": "#/$defs/temporal"
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "temporal": {
      "type": "string",
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "entityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "entity"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/identifier"
        },
        "entity": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
